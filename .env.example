# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
WORDPRESS_ORIGIN=https://theseptictankman.com

# Database
# Postgres connection string from Supabase or another host.
# Use the pooled connection string on Vercel (port 6543).
# URL-encode special characters in the password.
DATABASE_URL=

# Optional Supabase helpers for local scripts.
SUPABASE_URL=
SUPABASE_DIRECT_CONNECTION_STRING=
SUPABASE_DB_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=

# Admin
# Long random string, at least 16 characters.
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-password

# HighLevel private integration
# Official API: https://marketplace.gohighlevel.com/docs/
# Base URL: https://services.leadconnectorhq.com
# Version header: 2021-07-28
GHL_PRIVATE_INTEGRATION_TOKEN=pit-9c744a2c-fa3b-43da-ace7-e3d5df96557f
GHL_LOCATION_ID=p7HYMD0h2RScLKL68uj0

# Google Business Profile
# Reviews list: GET https://mybusiness.googleapis.com/v4/accounts/{accountId}/locations/{locationId}/reviews
# OAuth scope: https://www.googleapis.com/auth/business.manage
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCESS_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# Geocoder: mock | google | mapbox | nominatim
GEOCODING_PROVIDER=mock
GEOCODING_API_KEY=

# Optional custom map tiles. Carto Positron is used by default and needs no key.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Sync / Vercel Cron
# Vercel sends Authorization: Bearer $CRON_SECRET to cron routes.
CRON_SECRET=replace-with-a-long-random-secret

# Development
# When true, Google and GHL credentials are not required.
# Seed/test reviews power /map and /admin.
# Never leave this true in production unless you intentionally want demo pins.
MOCK_MODE=true

# Leave false until match quality is proven.
AUTO_APPROVE_HIGH_CONFIDENCE=false
